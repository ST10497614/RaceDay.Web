
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
          rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <!-- RaceDay Styles -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- NAVIGATION -->
    <header>
        <nav class="navbar navbar-expand-lg raced ay-navbar shadow-sm">
            <div class="container">

                <!-- BRAND -->
                <a class="navbar-brand raced ay-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-stopwatch-fill"></i>
                    RACE<span>DAY.</span>
                </a>

                <!-- MOBILE MENU -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav"
                        aria-controls="navbarNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <!-- MAIN LINKS -->
                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">
                                About
                            </a>
                        </li>

                        @if (string.IsNullOrEmpty(Context.Session.GetString("UserRole")))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Index">
                                    Explore Events
                                </a>
                            </li>
                        }

                        @if (Context.Session.GetString("UserRole") == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Organiser Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Events">
                                    My Events
                                </a>
                            </li>
                        }

                        @if (Context.Session.GetString("UserRole") == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Index">
                                    Browse Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="MyEnrolments">
                                    My Enrolments
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="MyResults">
                                    My Results
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- ACCOUNT LINKS -->
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserEmail")))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle user-menu"
                                   href="#"
                                   id="userDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-person-circle me-2"></i>

                                    @Context.Session.GetString("UserName")

                                    <span class="user-role">
                                        @Context.Session.GetString("UserRole")
                                    </span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0"
                                    aria-labelledby="userDropdown">

                                    @if (Context.Session.GetString("UserRole") == "Participant")
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Participant"
                                               asp-action="Profile">
                                                <i class="bi bi-person me-2"></i>
                                                My Profile
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider" /></li>
                                    }

                                    @if (Context.Session.GetString("UserRole") == "Organiser")
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Organiser"
                                               asp-action="Dashboard">
                                                <i class="bi bi-speedometer2 me-2"></i>
                                                Dashboard
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider" /></li>
                                    }

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Auth"
                                           asp-action="Logout">

                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Log out
                                        </a>
                                    </li>

                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-lg-2">
                                <a class="btn btn-login"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-register"
                                   asp-controller="Auth"
                                   asp-action="Register">
                                    Join RaceDay
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- NOTIFICATIONS -->
    @if (TempData["SuccessMessage"] != null ||
         TempData["Success"] != null ||
         TempData["Error"] != null)
    {
        <div class="container mt-3">

            @if (TempData["SuccessMessage"] != null || TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm"
                     role="alert">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    @(TempData["SuccessMessage"] ?? TempData["Success"])

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm"
                     role="alert">

                    <i class="bi bi-exclamation-circle-fill me-2"></i>

                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            }

        </div>
    }

    <!-- PAGE CONTENT -->
    <main role="main" class="flex-grow-1">

        @RenderBody()

    </main>

    <!-- FOOTER -->
    <footer class="raceday-footer mt-auto">

        <div class="container">

            <div class="row gy-4">

                <div class="col-md-5">

                    <a class="footer-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        <i class="bi bi-stopwatch-fill"></i>
                        RACE<span>DAY.</span>
                    </a>

                    <p>
                        Every step has a story.
                        Discover events, challenge yourself
                        and become part of the RaceDay community.
                    </p>

                </div>

                <div class="col-md-3">

                    <h6>EXPLORE</h6>

                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Home" asp-action="About">About Us</a>
                    <a asp-controller="Participant" asp-action="Index">Events</a>

                </div>

                <div class="col-md-4">

                    <h6>JOIN THE COMMUNITY</h6>

                    <p>
                        Your next running adventure starts here.
                    </p>

                    <a asp-controller="Auth"
                       asp-action="Register"
                       class="footer-join">

                        Create an Account
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

            <hr />

            <div class="footer-bottom">

                <small>
                    &copy; @DateTime.Now.Year RaceDay Platform.
                    All rights reserved.
                </small>

                <small>
                    BUILT FOR EVERY FINISH LINE.
                </small>

            </div>

        </div>

    </footer>

    <!-- BOOTSTRAP JAVASCRIPT -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
