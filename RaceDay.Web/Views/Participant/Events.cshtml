@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Explore Events";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Explore Events</h1>

        <p class="lead text-muted">
            Discover exciting races and find your next challenge.
        </p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card event-card h-100 shadow-sm border-0">

                        @if (!string.IsNullOrWhiteSpace(item.BannerImageUrl))
                        {
                            <img src="@item.BannerImageUrl"
                                 class="card-img-top"
                                 alt="@item.Name"
                                 style="height:220px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height:220px;">

                                <div class="text-center text-muted">
                                    <i class="bi bi-trophy-fill display-3"></i>
                                    <p class="mt-2 mb-0">RaceDay Event</p>
                                </div>

                            </div>
                        }

                        <div class="card-body d-flex flex-column p-4">

                            <h4 class="fw-bold mb-3">
                                @item.Name
                            </h4>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <div class="mb-2">
                                <i class="bi bi-calendar-event text-primary"></i>

                                <strong>Date:</strong>
                                @item.Date.ToString("dd MMMM yyyy")
                            </div>

                            <div class="mb-4">
                                <i class="bi bi-geo-alt-fill text-primary"></i>

                                <strong>Location:</strong>
                                @item.Location
                            </div>

                            <a asp-controller="Participant"
                               asp-action="EventDetails"
                               asp-route-id="@item.EventId"
                               class="btn btn-primary mt-auto w-100">

                                View Event Details
                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info text-center p-4">

            <i class="bi bi-info-circle display-5"></i>

            <h4 class="mt-3">No Events Available</h4>

            <p class="mb-0">
                There are currently no events to display.
                Please check again later.
            </p>

        </div>
    }

</div>
