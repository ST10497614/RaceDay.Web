@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="container py-4">

    <h1 class="page-heading">Upcoming Races</h1>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card p-3 h-100">

                    <h4>@item.Name</h4>

                    <p>@item.Description</p>

                    <p>
                        <strong>Date:</strong>
                        @item.Date.ToString("dd MMM yyyy")
                    </p>

                    <p>
                        <strong>Location:</strong>
                        @item.Location
                    </p>

                    <a asp-action="EventDetails"
                       asp-route-id="@item.EventId"
                       class="btn btn-primary mt-auto">
                        Event Details
                    </a>

                </div>
            </div>
        }

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No upcoming races are currently available.
        </div>
    }

</div>

