@model IEnumerable<RaceDay.Web.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Race Categories</h2>
            <p class="text-muted">Manage the categories available for race events.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Category
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No categories were returned by the API.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Category ID</th>
                        <th>Event ID</th>
                        <th>Category</th>
                        <th>Distance (km)</th>
                        <th>Maximum Participants</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryId</td>
                            <td>@category.EventId</td>
                            <td>@category.CategoryName</td>
                            <td>@category.DistanceKm</td>
                            <td>@category.MaxParticipants</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
