@model IEnumerable<RaceDay.Web.Models.ResultViewModel>

@{
    ViewData["Title"] = "Event Results";
    var eventId = (int)ViewBag.EventId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Race Results</h2>
            <p class="text-muted">Event ID: @eventId</p>
        </div>

        <a asp-action="Enter"
           asp-route-eventId="@eventId"
           class="btn btn-primary">
            + Enter Result
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No results have been published for this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Result ID</th>
                        <th>Enrolment ID</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model.OrderBy(r => r.Position))
                    {
                        <tr>
                            <td>@result.ResultId</td>
                            <td>@result.EnrolmentId</td>
                            <td>
                                @(result.FinishTime?.ToString("HH:mm:ss")
                                    ?? "Not recorded")
                            </td>
                            <td>
                                @(result.Position?.ToString()
                                    ?? "Not recorded")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
