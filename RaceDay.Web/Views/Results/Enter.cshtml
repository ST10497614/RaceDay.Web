@model RaceDay.Web.Models.ResultEntryViewModel

@{
    ViewData["Title"] = "Enter Race Result";
    var eventId = (int)ViewBag.EventId;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2>Enter Race Result</h2>
            <p class="text-muted">Event ID: @eventId</p>

            <form asp-action="Enter"
                  asp-route-eventId="@eventId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="EnrolmentId"
                           class="form-label">
                        Participant Enrolment ID
                    </label>

                    <input asp-for="EnrolmentId"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="EnrolmentId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FinishTime"
                           class="form-label">
                        Finish Time
                    </label>

                    <input asp-for="FinishTime"
                           type="time"
                           step="1"
                           class="form-control" />

                    <span asp-validation-for="FinishTime"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Position"
                           class="form-label">
                        Finishing Position
                    </label>

                    <input asp-for="Position"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="Position"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Publish Result
                </button>

                <a asp-action="EventResults"
                   asp-route-eventId="@eventId"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
