@model IEnumerable<RaceDay.Web.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2>My Race Results</h2>

    <p class="text-muted">
        View your published race finishing times and positions.
    </p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You do not have any published race results yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Result ID</th>
                        <th>Enrolment ID</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model.OrderBy(r => r.Position))
                    {
                        <tr>
                            <td>@result.ResultId</td>
                            <td>@result.EnrolmentId</td>
                            <td>
                                @(result.FinishTime?.ToString("HH:mm:ss")
                                    ?? "Not recorded")
                            </td>
                            <td>
                                @if (result.Position.HasValue)
                                {
                                    <span class="badge bg-success">
                                        @result.Position
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Pending
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
