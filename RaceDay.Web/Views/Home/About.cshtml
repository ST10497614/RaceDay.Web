@{
    ViewData["Title"] = "About Us";
}

<section class="about-hero">
    <div class="container">
        <span class="hero-label">OUR STORY</span>
        <h1>We believe every runner has a story.</h1>
        <p>
            RaceDay brings people, running events and unforgettable
            experiences together.
        </p>
    </div>
</section>

<section class="about-section">
    <div class="container">
        <div class="about-grid">
            <div>
                <span class="section-kicker">WHO WE ARE</span>
                <h2>Built for the love of running.</h2>

                <p>
                    RaceDay is a platform designed to connect runners
                    with exciting events and make event participation
                    easier.
                </p>

                <p>
                    From discovering an event to registering and
                    preparing for race day, we want every step
                    of the experience to be simple and enjoyable.
                </p>
            </div>

            <div class="about-image"></div>
        </div>

        <div class="mission-grid">
            <div class="mission-card">
                <span>01</span>
                <h3>Our Mission</h3>
                <p>
                    To make discovering and participating in running
                    events easier, more accessible and enjoyable.
                </p>
            </div>

            <div class="mission-card">
                <span>02</span>
                <h3>Our Vision</h3>
                <p>
                    To build a connected running community where
                    everyone has the opportunity to participate,
                    improve and achieve.
                </p>
            </div>

            <div class="mission-card">
                <span>03</span>
                <h3>Our Values</h3>
                <p>
                    Community, determination, inclusivity,
                    achievement and a passion for movement.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="race-cta">
    <div class="container cta-content">
        <span>YOUR JOURNEY STARTS HERE</span>
        <h2>Find your next challenge.</h2>
        <p>Become part of the RaceDay community.</p>

        <a href="/Events" class="btn-raceday">
            Discover Events →
        </a>
    </div>
</section>
