# Copy this file to .env and replace both values before running Docker Compose.
# SQL Server must be reachable from Docker. On Windows, host.docker.internal can reach the host.
RACEDAY_DB_CONNECTION=Server=host.docker.internal,1433;Database=RaceDayDB;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;Encrypt=False
# Generate a new secret with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
RACEDAY_JWT_KEY=REPLACE_WITH_A_NEW_RANDOM_32_BYTE_BASE64_SECRET
